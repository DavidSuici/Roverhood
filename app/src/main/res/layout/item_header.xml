<?xml version="1.0" encoding="utf-8"?>
<!-- First element of the feed: space under the banner / filters bar, and the team panel
     (only visible when the feed is filtered by a team). It scrolls with the posts. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <Space
        android:layout_width="match_parent"
        android:layout_height="50dp" />

    <Space
        android:id="@+id/spaceFilters"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/teamPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/teamPanelEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="40sp"
                tools:text="⚜️" />

            <TextView
                android:id="@+id/teamPanelName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:textColor="?attr/colorPrimary"
                android:textSize="26sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Topaz" />

            <TextView
                android:id="@+id/teamPanelEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="Edit"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/teamPanelMembersLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0.7"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Members (12)" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/teamPanelMembers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0.7"
            android:text="Posts"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- User profile panel: only visible when the feed is filtered by a user.
         Shows only the information that was filled in (e.g. no photo -> no photo). -->
    <LinearLayout
        android:id="@+id/userPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/userPanelPhoto"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="12dp"
                android:padding="3dp"
                android:background="@drawable/bg_profile_frame"
                android:scaleType="centerCrop"
                android:contentDescription="Profile photo"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/userPanelRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:textSize="12sp"
                    tools:text="PARTICIPANT" />

                <TextView
                    android:id="@+id/userPanelName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    tools:text="DavidSuici" />

                <TextView
                    android:id="@+id/userPanelTeam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:background="?attr/selectableItemBackground"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Topaz ⚜️" />
            </LinearLayout>

            <TextView
                android:id="@+id/userPanelEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="Edit"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Optional info from Edit profile; only the filled fields are listed -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:alpha="0.7"
            android:text="User Info"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/userPanelInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0.7"
            android:text="Posts"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Shown when the filters leave no posts: under the profile / team panel, not above it -->
    <TextView
        android:id="@+id/headerNoPosts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:alpha="0.7"
        android:text="No posts"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
